{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/server/**/*", "src/shared/**/*", "tests/**/*", "electron.vite.config.ts", "vite.web.config.ts", "vite.server.config.ts", "capacitor.config.ts", "vitest.config.ts"]
}
