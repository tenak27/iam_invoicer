{
  "name": "iam-erp",
  "productName": "IAM INVOICER",
  "version": "0.6.0",
  "description": "IAM INVOICER — facturation, caisse, stock et comptabilité SYSCOHADA d'IAM Technology (Burkina Faso)",
  "author": "IAM Technology",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "electron-vite build && node tests/e2e.mjs",
    "icons": "node scripts/icons.mjs && capacitor-assets generate --iconBackgroundColor \"#0b4f8a\" --iconBackgroundColorDark \"#0a1a2b\" --splashBackgroundColor \"#0b4f8a\" --splashBackgroundColorDark \"#0a1a2b\"",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist": "npm run dist:win",
    "build:web": "vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "server": "node out/server/server.cjs",
    "build:all-server": "npm run build:web && npm run build:server && npm run build:site",
    "cap:sync": "npm run build:web && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "android:apk": "npm run cap:sync && cd android && gradlew assembleRelease",
    "build:site": "node tools/site/build.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "pdfjs-dist": "^5.7.284"
  }
}
