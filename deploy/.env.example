# Nom de domaine pointant vers ce serveur
DOMAIN=facturation.iam.bf
# Mot de passe de la base PostgreSQL (long et aléatoire)
DB_PASSWORD=changez-moi
# Hébergement de plusieurs clients (une base chacun) : jeton d'administration, 64 caractères
# (openssl rand -hex 32). À saisir dans IAM INVOICER → Émission de licences → Bases clients en ligne.
# Laissez vide pour un serveur réservé à une seule société.
ADMIN_TOKEN=
# Clé de chiffrement des secrets enregistrés en base (mots de passe de messagerie, clés SMS, jetons,
# mots de passe des bases hébergées) : openssl rand -hex 32. Gardez-en une copie hors du serveur.
SECRETS_KEY=
